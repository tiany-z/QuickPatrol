.slider-container {
  position: relative;
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #1a1a1a;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  user-select: none;
}

.slider-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.before-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  overflow: hidden;
  border-right: 2rpx solid rgba(255, 255, 255, 0.9);
  z-index: 2;
}

.badge {
  position: absolute;
  top: 20rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 8rpx;
  backdrop-filter: blur(8px);
  z-index: 3;
}

.before-badge {
  left: 20rpx;
  background: rgba(239, 68, 68, 0.85);
  color: #ffffff;
}

.after-badge {
  right: 20rpx;
  background: rgba(16, 185, 129, 0.85);
  color: #ffffff;
}

.divider-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background-color: #ffffff;
  transform: translateX(-50%);
  z-index: 4;
  pointer-events: none;
}

.handle-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.arrow {
  font-size: 18rpx;
  color: #4b5563;
}
