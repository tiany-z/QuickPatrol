.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet-container {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)) 32rpx;
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.sheet-title-box {
  display: flex;
  align-items: baseline;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.sheet-subtitle {
  font-size: 22rpx;
  color: #888888;
  margin-left: 8rpx;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f3f5;
}

.close-icon {
  font-size: 24rpx;
  color: #666666;
}

/* 微信免密头像昵称 */
.auth-bar {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.avatar-choose-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1;
  border: none;
}

.avatar-choose-btn::after {
  border: none;
}

.guest-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #dee2e6;
}

.avatar-hint {
  font-size: 16rpx;
  color: #0078d7;
  margin-top: 6rpx;
}

.nick-input-box {
  flex: 1;
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.nick-label {
  font-size: 24rpx;
  color: #495057;
  white-space: nowrap;
}

.nick-input {
  flex: 1;
  height: 64rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #212529;
  border: 1rpx solid #e9ecef;
}

/* 文本区 */
.content-box {
  position: relative;
  margin-bottom: 28rpx;
}

.comment-textarea {
  width: 100%;
  height: 180rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #212529;
}

.word-counter {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: #adb5bd;
}

/* 底部操作 */
.sheet-actions {
  display: flex;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f1f3f5;
  color: #495057;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.btn-submit {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #0078d7 0%, #005a9e 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
}

.btn-disabled {
  opacity: 0.6;
}
