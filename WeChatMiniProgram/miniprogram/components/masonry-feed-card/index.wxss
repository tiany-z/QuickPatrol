.masonry-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  display: flex;
  flex-direction: column;
}

.masonry-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.card-top {
  border: 2rpx solid #ffaa00;
  background: linear-gradient(180deg, #fffdf8 0%, #ffffff 100%);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 16rpx 10rpx 16rpx;
}

.track-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-repair {
  background: rgba(0, 120, 215, 0.1);
  color: #0078d7;
}

.badge-reply {
  background: rgba(220, 53, 69, 0.1);
  color: #dc3545;
}

.badge-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

.top-tag {
  background: #ffaa00;
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: bold;
}

/* 轨 A: 抢修滑块与说明 */
.repair-slider-box {
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.repair-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx;
  font-size: 20rpx;
}

.meta-tag {
  color: #28a745;
  font-weight: 500;
}

.meta-handler {
  color: #888888;
}

/* 轨 B: 官方红头预览 */
.decree-preview-box {
  margin: 0 16rpx;
  padding: 16rpx;
  background: #fdf5f5;
  border-radius: 14rpx;
  border: 1rpx dashed rgba(220, 53, 69, 0.3);
  position: relative;
  overflow: hidden;
}

.decree-header {
  display: flex;
  flex-direction: column;
}

.decree-dept {
  font-size: 22rpx;
  font-weight: bold;
  color: #c82333;
}

.decree-officer {
  font-size: 18rpx;
  color: #666666;
  margin-top: 4rpx;
}

.decree-seal-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.decree-seal {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.85;
}

.promise-tag {
  background: #e9ecef;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.promise-text {
  font-size: 18rpx;
  color: #495057;
}

.thanks-badge {
  display: inline-block;
  margin-top: 8rpx;
  background: #fff0f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffb6c1;
}

.thanks-text {
  font-size: 18rpx;
  color: #d63384;
}

/* 正文 */
.card-body {
  padding: 12rpx 16rpx;
}

.card-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  color: #212529;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.card-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: 22rpx;
  color: #6c757d;
  line-height: 1.4;
}

/* 相册 */
.album-preview {
  position: relative;
  margin: 0 16rpx 12rpx 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  height: 180rpx;
}

.album-img {
  width: 100%;
  height: 100%;
}

.album-count-tag {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

/* 底部互动 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx 16rpx 16rpx;
  border-top: 1rpx solid #f8f9fa;
}

.creator-info {
  display: flex;
  align-items: center;
}

.creator-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #e9ecef;
}

.creator-name {
  font-size: 20rpx;
  color: #888888;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actions-group {
  display: flex;
  align-items: center;
}

.action-btn {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.like-btn.active .action-count {
  color: #dc3545;
  font-weight: bold;
}

.action-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.icon-pulse {
  animation: heartPulse 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes heartPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

.action-count {
  font-size: 20rpx;
  color: #666666;
}
