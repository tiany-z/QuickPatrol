<view class="app-session-card" bindtap="onTapItem" hover-class="app-session-card-hover" hover-stay-time="100">
  <view class="icon-wrapper">
    <image class="app-icon" src="{{session.appIcon || '/assets/icons/default.png'}}" mode="aspectFit" />
    <view class="badge" wx:if="{{session.unreadCount > 0}}">
      {{session.unreadCount > 99 ? '99+' : session.unreadCount}}
    </view>
  </view>

  <view class="info-content">
    <view class="top-line">
      <text class="app-name">{{session.appName || '微应用助手'}}</text>
      <text class="official-tag">官方</text>
      <text class="time-text">{{session.formattedTimeText || ''}}</text>
    </view>
    <view class="summary-line">
      <text class="title-prefix" wx:if="{{session.lastNoticeTitle}}">[{{session.lastNoticeTitle}}] </text>
      <text class="snippet">{{session.lastNoticeSnippet || '暂无新通知'}}</text>
    </view>
  </view>
</view>
