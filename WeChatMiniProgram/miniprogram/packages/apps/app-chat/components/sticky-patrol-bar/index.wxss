/* M37: 顶部工单微状态吸顶药丸样式 (sticky-patrol-bar) */

.sticky-bar-wrap {
  width: 100%;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  position: sticky;
  top: 0;
  z-index: 100;
}

.sticky-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 24rpx;
}

.pill-left {
  display: flex;
  align-items: center;
}

.pill-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.pill-order {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A202C;
  margin-right: 14rpx;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.badge-normal {
  background: #EBF8FF;
}

.badge-urgent {
  background: #FEEBC8;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.badge-normal .dot {
  background: #3182CE;
}

.badge-urgent .dot {
  background: #DD6B20;
}

.dot-pulse {
  animation: pulseDot 1.2s infinite ease-in-out;
}

@keyframes pulseDot {
  0% {
    transform: scale(0.9);
    opacity: 0.7;
  }
  50% {
    transform: scale(1.4);
    opacity: 1;
  }
  100% {
    transform: scale(0.9);
    opacity: 0.7;
  }
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
}

.badge-normal .badge-text {
  color: #2B6CB0;
}

.badge-urgent .badge-text {
  color: #C05621;
}

.pill-right {
  display: flex;
  align-items: center;
}

.pill-location {
  font-size: 22rpx;
  color: #718096;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
}

.pill-arrow {
  font-size: 18rpx;
  color: #A0AEC0;
}
