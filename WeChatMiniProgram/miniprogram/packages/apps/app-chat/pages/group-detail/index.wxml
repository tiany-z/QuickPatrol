<view class="group-detail-container">
  <qp-navbar title="群聊设置与成员" showBack="{{true}}" />
  <!-- 群成员网格列表 -->
  <view class="section-card">
    <view class="section-title">群成员 ({{memberCount}}人)</view>
    <view class="member-grid">
      <block wx:for="{{members}}" wx:key="userId">
        <view class="member-item">
          <view class="avatar-wrap">
            <image class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <text wx:if="{{item.role === 2}}" class="role-badge owner">群主</text>
            <text wx:elif="{{item.role === 1}}" class="role-badge admin">管理</text>
          </view>
          <text class="member-name">{{item.nickInGroup || item.realName || item.nickName}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 群信息与设置项 -->
  <view class="section-card">
    <view class="cell-row">
      <text class="cell-label">群聊名称</text>
      <text class="cell-value">{{title}}</text>
    </view>
    <view class="cell-row" wx:if="{{patrolId}}">
      <text class="cell-label">关联工单</text>
      <text class="cell-value tag">#{{patrolId}} 应急抢险</text>
    </view>
    <view class="cell-row clickable" bindtap="onTapOpenNoticeModal">
      <text class="cell-label">群公告</text>
      <view class="cell-right">
        <text class="cell-value notice-preview">{{currentNotice ? currentNotice.content : '未设置公告'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 消息与偏好 -->
  <view class="section-card">
    <view class="cell-row">
      <text class="cell-label">消息免打扰</text>
      <switch checked="{{isMuted}}" color="#1890FF" bindchange="onToggleMute" />
    </view>
  </view>

  <!-- 退出或解散按钮 -->
  <view class="action-btn-area">
    <button class="leave-btn" bindtap="onTapLeaveGroup">
      {{isOwner && memberCount === 1 ? '解散该群聊' : '退出该群聊'}}
    </button>
  </view>

  <!-- 发布/修改群公告弹窗 -->
  <view class="modal-mask" wx:if="{{showNoticeModal}}">
    <view class="modal-box">
      <view class="modal-title">发布置顶公告</view>
      <textarea 
        class="modal-textarea" 
        placeholder="请输入群公告内容..." 
        value="{{newNoticeContent}}" 
        bindinput="onNoticeInput" 
        maxlength="200"
      />
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="onCancelNotice">取消</button>
        <button class="modal-btn confirm" bindtap="onSubmitNotice">发布并置顶</button>
      </view>
    </view>
  </view>
</view>
