.group-room-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F8FA;
  box-sizing: border-box;
}

.group-header-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EBEEF5;
}

.header-left {
  display: flex;
  align-items: center;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.tag-badge.incident {
  background-color: #FFF1F0;
  color: #CF1322;
  border: 1rpx solid #FFA39E;
}

.tag-badge.dept {
  background-color: #E6F7FF;
  color: #096DD9;
  border: 1rpx solid #91D5FF;
}

.member-count {
  font-size: 22rpx;
  color: #8C8C8C;
}

.setting-btn {
  font-size: 24rpx;
  color: #1890FF;
  padding: 6rpx 14rpx;
  background-color: #F0F5FF;
  border-radius: 8rpx;
}

.message-scroll-area {
  flex: 1;
  width: 100%;
  overflow-y: scroll;
}

.message-list-inner {
  padding: 24rpx 16rpx;
  box-sizing: border-box;
}

.message-row-wrapper {
  margin-bottom: 24rpx;
}

.bottom-input-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EBEEF5;
  box-sizing: border-box;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background-color: #F2F4F7;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.send-btn {
  width: 130rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #1890FF, #096DD9);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
  margin: 0;
}
