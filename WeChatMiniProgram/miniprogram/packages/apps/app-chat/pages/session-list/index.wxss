/* M40: 协同会话大盘列表样式 (session-list) */

page {
  height: 100%;
  background-color: #F7FAFC;
}

.session-list-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部统计摘要条 */
.stats-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #EDF2F7;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.stats-info {
  display: flex;
  align-items: baseline;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A202C;
  margin-right: 14rpx;
}

.stats-count {
  font-size: 24rpx;
  color: #718096;
}

.stats-unread-pill {
  display: flex;
  align-items: center;
  background-color: #FFF5F5;
  border: 1rpx solid #FED7D7;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background-color: #E53E3E;
  margin-right: 8rpx;
}

.unread-text {
  font-size: 22rpx;
  color: #C53030;
  font-weight: 600;
}

/* 列表滚动容器 */
.session-scroll-list {
  flex: 1;
  height: 100%;
}

.session-items-wrapper {
  padding-bottom: 40rpx;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #3182CE;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #A0AEC0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A5568;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #A0AEC0;
  text-align: center;
  line-height: 36rpx;
  max-width: 500rpx;
}
