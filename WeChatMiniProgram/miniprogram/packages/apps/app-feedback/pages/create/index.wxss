.container {
  padding: 24rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部横幅 */
.vault-banner {
  background: linear-gradient(135deg, #1e293b, #0f172a);
  border-radius: 20rpx;
  padding: 28rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.15);
}
.banner-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.banner-icon {
  font-size: 32rpx;
}
.banner-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

/* 草稿提示栏 */
.draft-tip-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #eff6ff;
  border-left: 6rpx solid #3b82f6;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  margin-bottom: 20rpx;
}
.draft-clear-btn {
  color: #64748b;
  text-decoration: underline;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}
.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}
.picker-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #3b82f6;
}
.arrow {
  font-size: 20rpx;
  color: #94a3b8;
}

.form-item-vertical {
  margin-bottom: 28rpx;
}
.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.char-count {
  font-size: 22rpx;
  color: #94a3b8;
}
.input-control {
  width: 100%;
  height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
}
.textarea-control {
  width: 100%;
  height: 220rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.5;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}
.photo-item {
  position: relative;
  width: 100%;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.photo-add-btn {
  width: 100%;
  height: 140rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  gap: 4rpx;
}
.add-icon {
  font-size: 40rpx;
  line-height: 1;
}
.add-text {
  font-size: 20rpx;
}

/* 开关选项卡片 */
.switch-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 40rpx;
}
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.switch-text {
  flex: 1;
  padding-right: 20rpx;
}
.switch-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 6rpx;
}
.secure-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  background: #dbeafe;
  color: #2563eb;
  border-radius: 6rpx;
  font-weight: 700;
}
.switch-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}
.divider {
  height: 1rpx;
  background-color: #f1f5f9;
  margin: 24rpx 0;
}

/* 提交按钮 */
.submit-wrapper {
  margin-bottom: 60rpx;
}
.btn-submit {
  width: 100%;
  height: 88rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
}
