.detail-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
  box-sizing: border-box;
}

.status-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.status-replied {
  background: linear-gradient(135deg, #ba181b 0%, #e53935 100%);
  color: #ffffff;
}

.status-pending {
  background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%);
  color: #ffffff;
}

.status-icon {
  font-size: 48rpx;
}

.status-info {
  display: flex;
  flex-direction: column;
}

.status-title {
  font-size: 30rpx;
  font-weight: 700;
}

.status-desc {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.detail-scroll {
  flex: 1;
  padding: 24rpx 28rpx 140rpx 28rpx;
  box-sizing: border-box;
}

.appeal-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.badge-anonymous {
  font-size: 22rpx;
  background: rgba(30, 136, 229, 0.1);
  color: #1565c0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.badge-realname {
  font-size: 22rpx;
  background: rgba(76, 175, 80, 0.1);
  color: #2e7d32;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.appeal-time {
  font-size: 22rpx;
  color: #999999;
}

.appeal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.appeal-content {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.6;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
}

.appeal-stats {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  font-size: 24rpx;
  color: #888888;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 32rpx 0 16rpx 0;
}

.section-badge {
  font-size: 18rpx;
  font-weight: 700;
  background: #ba181b;
  color: #ffffff;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

.badge-heart {
  background: #ff4081;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.thanks-wall-section {
  margin-top: 24rpx;
}

.thanks-cards-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.thanks-card-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #ffebed;
  box-shadow: 0 4rpx 16rpx rgba(255, 64, 129, 0.05);
}

.thanks-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.thanks-item-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #ba181b;
}

.thanks-item-date {
  font-size: 20rpx;
  color: #aaaaaa;
}

.thanks-item-comment {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
}

.thanks-item-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #ff8f00;
  background: #fff8e1;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.detail-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  padding: 20rpx 32rpx env(safe-area-inset-bottom);
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-action {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-share {
  flex: 1;
  background: #f5f5f5;
  color: #555555;
}

.btn-thanks {
  flex: 2;
  background: linear-gradient(135deg, #e53935 0%, #ba181b 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(186, 24, 27, 0.25);
}

.btn-already-sent {
  flex: 2;
  background: #e8f5e9;
  color: #2e7d32;
}

.btn-icon {
  font-size: 32rpx;
}
