/**
 * M20: 线下固定资产二维码与防作弊打卡核心页样式
 * 主题：深邃科技蓝黑 (Tech Obsidian) + 极光青 (Aurora) 沉浸式风格
 */

page {
  background-color: #0A0F1D;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.scan-point-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 15%, #1E293B 0%, #0A0F1D 70%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 极光背景氛围光斑 */
.aurora-bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  opacity: 0.35;
}

.glow-top {
  top: -100rpx;
  right: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: #0066FF;
}

.glow-bottom {
  bottom: 50rpx;
  left: -80rpx;
  width: 450rpx;
  height: 450rpx;
  background: #00D2B4;
  opacity: 0.2;
}

/* 1. 自定义顶部导航栏 */
.custom-nav-header {
  position: relative;
  z-index: 50;
  width: 100%;
}

.nav-content-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 190rpx 0 32rpx;
  box-sizing: border-box;
}

.nav-btn.back-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-hover {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.2);
}

.back-icon {
  font-size: 34rpx;
  color: #FFFFFF;
  line-height: 1;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.nav-placeholder {
  width: 68rpx;
}

/* 页面主体可滚动区域 */
.page-scroll-body {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}

/* 2. 全景雷达测距与全息取景感知卡片 */
.radar-hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 20rpx;
}

.radar-stage {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

/* 雷达波纹环 */
.radar-wave {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 210, 180, 0.4);
  pointer-events: none;
  box-sizing: border-box;
}

.wave-1 {
  width: 180rpx;
  height: 180rpx;
  border-color: rgba(0, 102, 255, 0.5);
}

.wave-2 {
  width: 250rpx;
  height: 250rpx;
  border-color: rgba(0, 210, 180, 0.35);
  animation: pulse-ring 3s infinite linear;
}

.wave-3 {
  width: 320rpx;
  height: 320rpx;
  border-color: rgba(0, 210, 180, 0.18);
  animation: pulse-ring 3s infinite 1.5s linear;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0.85);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.05);
    opacity: 0.3;
  }
  100% {
    transform: scale(1.18);
    opacity: 0;
  }
}

/* HUD 取景框 */
.viewfinder-hud {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  background: rgba(15, 23, 42, 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 102, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  z-index: 2;
}

.hud-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-color: #00D2B4;
  border-style: solid;
}

.top-left {
  top: 8rpx;
  left: 8rpx;
  border-width: 4rpx 0 0 4rpx;
}

.top-right {
  top: 8rpx;
  right: 8rpx;
  border-width: 4rpx 4rpx 0 0;
}

.bottom-left {
  bottom: 8rpx;
  left: 8rpx;
  border-width: 0 0 4rpx 4rpx;
}

.bottom-right {
  bottom: 8rpx;
  right: 8rpx;
  border-width: 0 4rpx 4rpx 0;
}

.hud-center-icon {
  font-size: 64rpx;
  animation: float-icon 2.4s ease-in-out infinite alternate;
}

@keyframes float-icon {
  0% {
    transform: translateY(-4rpx) scale(0.96);
  }
  100% {
    transform: translateY(4rpx) scale(1.04);
  }
}

/* 激光扫描线动画 */
.laser-beam {
  position: absolute;
  width: 180rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #00D2B4, #FFFFFF, #00D2B4, transparent);
  box-shadow: 0 0 16rpx #00D2B4;
  z-index: 5;
  animation: laser-move 1.8s ease-in-out infinite alternate;
}

@keyframes laser-move {
  0% {
    top: 75rpx;
    opacity: 0.6;
  }
  100% {
    top: 245rpx;
    opacity: 1;
  }
}

/* 状态胶囊徽标 */
.status-capsule {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  font-weight: 500;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.status-capsule.ready {
  background: rgba(16, 185, 129, 0.15);
  border: 1rpx solid rgba(16, 185, 129, 0.4);
  color: #34D399;
}

.status-capsule.processing {
  background: rgba(0, 102, 255, 0.2);
  border: 1rpx solid rgba(0, 210, 180, 0.5);
  color: #00D2B4;
}

.pulse-indicator {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 12rpx;
  box-shadow: 0 0 10rpx currentColor;
  animation: pulse-dot 1.2s infinite;
}

@keyframes pulse-dot {
  0% { opacity: 0.4; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.15); }
  100% { opacity: 0.4; transform: scale(0.85); }
}

/* 状态说明文本 */
.status-message-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 600rpx;
}

.status-main-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #F8FAFC;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.status-sub-text {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1.5;
}

/* 3. 三阶防伪安全引擎特性卡片 */
.security-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 30rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
}

.security-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.sec-badge {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.sec-version {
  font-size: 22rpx;
  color: #00D2B4;
  background: rgba(0, 210, 180, 0.12);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
}

.feature-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.blue-glow {
  background: rgba(0, 102, 255, 0.2);
  border: 1rpx solid rgba(0, 102, 255, 0.4);
}

.green-glow {
  background: rgba(16, 185, 129, 0.2);
  border: 1rpx solid rgba(16, 185, 129, 0.4);
}

.purple-glow {
  background: rgba(139, 92, 246, 0.2);
  border: 1rpx solid rgba(139, 92, 246, 0.4);
}

.feature-detail {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.feature-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #E2E8F0;
  margin-bottom: 4rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.45;
}

/* 4. 底部操作按钮群 */
.action-footer {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.primary-scan-btn {
  width: 100% !important;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #0066FF 0%, #00D2B4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(0, 102, 255, 0.4);
  transition: all 0.2s ease;
}

.primary-btn-hover {
  transform: scale(0.98);
  box-shadow: 0 6rpx 18rpx rgba(0, 102, 255, 0.3);
}

.primary-scan-btn.btn-disabled {
  opacity: 0.65;
  filter: grayscale(30%);
}

.primary-scan-btn .btn-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.secondary-back-btn {
  width: 100% !important;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #CBD5E1;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.secondary-btn-hover {
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
}

.brand-footer-text {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #64748B;
  text-align: center;
}
