/* packages/apps/app-master-desk/pages/handle-submit/index.wxss */
.handle-container {
  min-height: 100vh;
  background-color: #f7f9fc;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 32, 77, 0.05);
}

.patrol-card {
  border-left: 8rpx solid #1677ff;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.badge-status {
  background: rgba(22, 119, 255, 0.1);
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.order-no {
  font-size: 24rpx;
  color: #8c8c8c;
  font-family: monospace;
}

.patrol-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.patrol-meta {
  display: flex;
  font-size: 26rpx;
  color: #595959;
}

.meta-label {
  color: #8c8c8c;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #262626;
}

.required-star {
  color: #ff4d4f;
  margin-left: 6rpx;
  font-size: 28rpx;
}

.sub-hint {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-left: 12rpx;
}

.content-textarea {
  width: 100%;
  height: 220rpx;
  background: #fafafa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #262626;
  box-sizing: border-box;
}

.word-counter {
  text-align: right;
  font-size: 22rpx;
  color: #bfbfbf;
  margin-top: 10rpx;
}

.hours-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hour-chip {
  padding: 14rpx 28rpx;
  background: #f5f5f5;
  border: 2rpx solid #d9d9d9;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #595959;
  transition: all 0.2s ease;
}

.hour-chip.active {
  background: #e6f4ff;
  border-color: #1677ff;
  color: #1677ff;
  font-weight: 600;
}

.custom-hour-box {
  display: flex;
  align-items: center;
  padding-top: 12rpx;
  border-top: 2rpx dashed #f0f0f0;
}

.custom-label {
  font-size: 26rpx;
  color: #595959;
}

.hour-input {
  width: 180rpx;
  background: #fafafa;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 28rpx;
  margin: 0 12rpx;
  text-align: center;
}

.unit-text {
  font-size: 26rpx;
  color: #8c8c8c;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.image-item {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.preview-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.watermark-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(22, 119, 255, 0.85);
  color: #ffffff;
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
}

.upload-btn {
  width: 100%;
  padding-top: 100%;
  position: relative;
  background: #fafafa;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  position: absolute;
  top: 24%;
  font-size: 48rpx;
}

.upload-text {
  position: absolute;
  top: 56%;
  font-size: 24rpx;
  color: #595959;
}

.count-text {
  position: absolute;
  top: 76%;
  font-size: 20rpx;
  color: #bfbfbf;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  z-index: 100;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.35);
}

.submit-btn.disabled {
  opacity: 0.6;
}
