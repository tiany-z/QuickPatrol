/* 师傅抢修工作台样式 */
.desk-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F8F9FA;
}

/* 四象限 Tab 栏 */
.quadrant-tabs {
  display: flex;
  background-color: #FFFFFF;
  padding: 16rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6C757D;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item.active {
  color: #0078D4;
  font-weight: 600;
  border-bottom: 4rpx solid #0078D4;
}

.badge {
  font-size: 20rpx;
  color: #FFFFFF;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
  font-weight: bold;
}

.badge-pool { background-color: #E81123; }
.badge-assigned { background-color: #FF8C00; }
.badge-progress { background-color: #0078D4; }
.badge-review { background-color: #107C41; }

/* 任务列表 */
.task-scroll {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #0078D4;
  transition: transform 0.2s ease;
}

.task-card.card-urgent {
  border-left: 8rpx solid #E81123;
  animation: pulse-border 1.5s infinite alternate;
}

@keyframes pulse-border {
  from { box-shadow: 0 4rpx 20rpx rgba(232, 17, 35, 0.15); }
  to { box-shadow: 0 8rpx 30rpx rgba(232, 17, 35, 0.35); }
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 26rpx;
  color: #495057;
  font-family: monospace;
}

.priority-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

.p-2 { background-color: #FDE7E9; color: #D13438; }
.p-1 { background-color: #FFF4CE; color: #795E00; }
.p-0 { background-color: #EDEBE9; color: #605E5C; }

.sla-badge {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.sla-danger { background-color: #FDE7E9; color: #D13438; font-weight: bold; }
.sla-normal { background-color: #E1DFDD; color: #323130; }

.card-body {
  margin-bottom: 20rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 26rpx;
  color: #6C757D;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.task-location {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #495057;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #F3F2F1;
  padding-top: 16rpx;
}

.category-pill {
  font-size: 22rpx;
  background-color: #F3F2F1;
  color: #323130;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.btn-action {
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin: 0;
  font-weight: 500;
}

.btn-claim {
  background: linear-gradient(135deg, #0078D4 0%, #005A9E 100%);
  color: #FFFFFF;
}

.btn-transfer {
  background-color: #F3F2F1;
  color: #D13438;
  border: 1rpx solid #E1DFDD;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #A19F9D; }

/* 模态框 Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-dialog {
  background-color: #FFFFFF;
  width: 86%;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title { font-size: 32rpx; font-weight: bold; color: #212529; }
.modal-close { font-size: 36rpx; color: #8A8886; }

.modal-row { margin-bottom: 20rpx; }
.modal-row .label { font-size: 26rpx; color: #605E5C; display: block; margin-bottom: 8rpx; }
.modal-row .value { font-size: 28rpx; color: #201F1E; font-family: monospace; }

.picker-box {
  border: 1rpx solid #D2D0CE;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #323130;
}

.reason-input {
  width: 100%;
  height: 140rpx;
  border: 1rpx solid #D2D0CE;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-cancel {
  background-color: #F3F2F1;
  color: #605E5C;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin: 0;
}

.btn-confirm {
  background-color: #0078D4;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin: 0;
}
