/**
 * M22: 水印相机沉浸式深色专业取景样式
 */

page {
  background-color: #000000;
  height: 100vh;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.camera-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #000000;
}

/* 原生取景硬件视口 */
.hardware-camera {
  position: relative;
  width: 100vw;
  flex: 1;
}

/* 顶部导航控制栏 */
.top-nav-bar {
  position: absolute;
  top: calc(env(safe-area-inset-top, 44px) + 8px);
  left: 16px;
  right: 100px; /* 严格避让右上角微信胶囊按钮 */
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.icon-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.15);
  transition: all 0.2s ease;
}

.icon-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.2);
}

.btn-icon {
  color: #FFFFFF;
  font-size: 20px;
  font-weight: bold;
}

.mode-capsule-group {
  display: flex;
  gap: 10px;
}

.capsule-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 14px;
  border-radius: 20px;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #E2E8F0;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.capsule-btn.active {
  background: rgba(255, 215, 0, 0.25);
  border-color: #FFD700;
  color: #FFD700;
}

.capsule-btn:active {
  transform: scale(0.95);
}

.capsule-icon {
  font-size: 13px;
}

/* 取景对齐辅助框 */
.viewfinder-scrim {
  position: absolute;
  top: 15%;
  left: 8%;
  right: 8%;
  bottom: 25%;
  pointer-events: none;
}

.corner-marker {
  position: absolute;
  width: 24px;
  height: 24px;
  border-color: rgba(255, 255, 255, 0.7);
  border-style: solid;
}

.corner-marker.top-left {
  top: 0;
  left: 0;
  border-width: 3px 0 0 3px;
  border-top-left-radius: 6px;
}

.corner-marker.top-right {
  top: 0;
  right: 0;
  border-width: 3px 3px 0 0;
  border-top-right-radius: 6px;
}

.corner-marker.bottom-left {
  bottom: 0;
  left: 0;
  border-width: 0 0 3px 3px;
  border-bottom-left-radius: 6px;
}

.corner-marker.bottom-right {
  bottom: 0;
  right: 0;
  border-width: 0 3px 3px 0;
  border-bottom-right-radius: 6px;
}

/* 水印实时感知遮罩 */
.watermark-live-preview {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24px 20px 16px 20px;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.65) 30%, rgba(0, 0, 0, 0.9) 100%);
  display: flex;
  flex-direction: column;
  gap: 6px;
  pointer-events: none;
}

.watermark-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2px;
}

.scene-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 6px;
  background: rgba(255, 215, 0, 0.15);
  border: 1px solid rgba(255, 215, 0, 0.4);
  color: #FFD700;
  font-size: 12px;
  font-weight: bold;
}

.fingerprint-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #10B981;
  font-size: 11px;
  font-weight: 500;
}

.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 8px #10B981;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 6px;
}

.primary-loc .loc-text {
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 600;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
}

.sec-info .info-text {
  color: #94A3B8;
  font-size: 11px;
}

/* 底部快门控制底座 */
.bottom-control-deck {
  height: 140px;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.status-indicator-bar {
  margin-bottom: 12px;
}

.status-text {
  color: #94A3B8;
  font-size: 12px;
  letter-spacing: 0.5px;
  transition: color 0.3s ease;
}

.status-text.processing {
  color: #38BDF8;
  font-weight: 600;
}

.shutter-action-area {
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-outer-ring {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  border: 4px solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 16px rgba(255, 255, 255, 0.2);
}

.shutter-outer-ring:active {
  transform: scale(0.92);
  border-color: #38BDF8;
}

.shutter-outer-ring.shooting {
  border-color: #38BDF8;
  animation: ring-pulse 1.2s infinite ease-in-out;
}

@keyframes ring-pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

.shutter-inner-core {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.shutter-inner-core.busy {
  background: #0F172A;
}

.spinner-ring {
  width: 28px;
  height: 28px;
  border: 3px solid rgba(56, 189, 248, 0.25);
  border-top-color: #38BDF8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
