page {
  height: 100%;
  background: #F8F9FB;
}

.chat-page-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.banner-wrapper {
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.chat-message-list {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.patrol-info-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 30rpx;
}

.patrol-badge {
  display: inline-block;
  background: #EBF5FF;
  color: #007AFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.patrol-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  display: block;
}

.patrol-loc {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 6rpx;
  display: block;
}

/* 居中系统气泡 */
.system-bubble-box {
  display: flex;
  justify-content: center;
  margin: 24rpx 0;
}

.system-bubble-pill {
  background: rgba(0, 0, 0, 0.06);
  color: #636366;
  font-size: 22rpx;
  line-height: 32rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  text-align: center;
  max-width: 85%;
}

.empty-tip {
  display: flex;
  justify-content: center;
  margin-top: 60rpx;
  color: #AEAEB2;
  font-size: 24rpx;
}

/* 底部输入框状态 */
.bottom-input-bar {
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.bar-locked {
  background: #F2F2F7;
}

.input-control {
  flex: 1;
  height: 72rpx;
  background: #F2F2F7;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.send-btn {
  background: #007AFF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  margin: 0;
}

.locked-mask {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(142, 142, 147, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.lock-icon {
  font-size: 24rpx;
  opacity: 0.7;
}

.lock-text {
  font-size: 22rpx;
  color: #8E8E93;
}
