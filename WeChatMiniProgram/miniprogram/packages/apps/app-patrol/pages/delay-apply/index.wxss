/**
 * M26: 师傅端延期申报页面样式表
 * (Patrol Delay Apply Styles)
 */

.delay-page-container {
  min-height: 100vh;
  background-color: #F8FAFC;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
}

/* 顶部工单卡片 */
.order-info-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-no-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
}

.status-badge {
  font-size: 22rpx;
  background-color: #DBEAFE;
  color: #1D4ED8;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.deadline-row {
  display: flex;
  align-items: baseline;
  font-size: 24rpx;
}

.deadline-label {
  color: #64748B;
}

.deadline-val {
  color: #DC2626;
  font-weight: 600;
}

/* 通用区块卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.title-required {
  color: #EF4444;
  font-size: 28rpx;
}

.title-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

/* 时长选择网格 */
.hours-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hour-chip {
  padding: 16rpx 28rpx;
  background-color: #F1F5F9;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.hour-chip-active {
  background: #EFF6FF;
  border-color: #2563EB;
}

.chip-label {
  font-size: 26rpx;
  color: #475569;
}

.hour-chip-active .chip-label {
  color: #2563EB;
  font-weight: 600;
}

/* 自定义时长输入 */
.custom-hours-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  background: #F8FAFC;
  border: 1rpx solid #CBD5E1;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}

.custom-input {
  flex: 1;
  font-size: 28rpx;
  color: #0F172A;
}

.unit-text {
  font-size: 26rpx;
  color: #64748B;
}

/* 预计完工时间横幅 */
.predicted-deadline-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid #FCD34D;
}

.banner-icon {
  font-size: 30rpx;
}

.banner-text {
  font-size: 24rpx;
  color: #92400E;
  font-weight: 500;
}

/* 原因多行文本框 */
.reason-textarea {
  width: 100%;
  height: 200rpx;
  background-color: #F8FAFC;
  border: 1rpx solid #CBD5E1;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #0F172A;
  box-sizing: border-box;
}

.char-counter {
  text-align: right;
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

/* 照片网格 */
.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.evidence-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.upload-trigger {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #CBD5E1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F8FAFC;
}

.plus-icon {
  font-size: 56rpx;
  color: #94A3B8;
  line-height: 1;
}

.upload-tip {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

/* 底部操作栏 */
.footer-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx 48rpx;
  border-top: 1rpx solid #E2E8F0;
  z-index: 100;
}

.submit-btn {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  height: 84rpx;
  line-height: 84rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.35);
}

.submit-btn[disabled] {
  background: #E2E8F0 !important;
  color: #94A3B8 !important;
  box-shadow: none !important;
}
