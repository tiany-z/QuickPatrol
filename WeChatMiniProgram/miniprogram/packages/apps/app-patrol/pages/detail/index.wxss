.container {
  padding: 24rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 骨架屏 */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.skeleton-card {
  background: #e2e8f0;
  border-radius: 16rpx;
  animation: pulse 1.5s infinite;
}
.skeleton-header { height: 160rpx; }
.skeleton-body { height: 420rpx; }
.skeleton-timeline { height: 500rpx; }

@keyframes pulse {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* 1. 顶部工单卡片 */
.header-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-no {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 0.5rpx;
}
.badge-group {
  display: flex;
  gap: 12rpx;
}
.priority-tag, .status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.priority-1 { background: #f1f5f9; color: #475569; }
.priority-2 { background: #e0f2fe; color: #0284c7; }
.priority-3 { background: #fef3c7; color: #d97706; }
.priority-4 { background: #fee2e2; color: #dc2626; }

.status-0 { background: #fef3c7; color: #b45309; }
.status-1 { background: #dbeafe; color: #1d4ed8; }
.status-2 { background: #f3e8ff; color: #7e22ce; }
.status-3 { background: #dcfce7; color: #15803d; }
.status-4 { background: #f1f5f9; color: #94a3b8; }
.status-5 { background: #fee2e2; color: #b91c1c; }

.header-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}
.meta-dot {
  color: #cbd5e1;
}

/* 2. 通用内容卡片 */
.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.title-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}
.title-sub {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 照片网格 */
.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.patrol-photo {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f1f5f9;
}
.empty-media {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 详情行 */
.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.info-label {
  color: #64748b;
  width: 150rpx;
  flex-shrink: 0;
}
.info-value {
  color: #1e293b;
  flex: 1;
}
.title-val {
  font-weight: 600;
}
.deadline-val {
  color: #ea580c;
  font-weight: 600;
}
.desc-val {
  color: #475569;
}

.divider {
  height: 1rpx;
  background-color: #f1f5f9;
  margin: 24rpx 0;
}

/* 当事人信息行 */
.parties-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 20rpx;
}
.party-box {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.party-role {
  font-size: 20rpx;
  color: #64748b;
}
.party-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}
.party-phone {
  font-size: 22rpx;
  color: #94a3b8;
}
.party-arrow {
  color: #94a3b8;
  font-size: 32rpx;
}

/* 时间轴 */
.timeline-container {
  padding-left: 16rpx;
}
.timeline-item {
  position: relative;
  padding-left: 36rpx;
  padding-bottom: 28rpx;
  border-left: 2rpx solid #e2e8f0;
}
.timeline-item:last-child {
  border-left: 2rpx solid transparent;
  padding-bottom: 0;
}
.timeline-dot {
  position: absolute;
  left: -9rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #3b82f6;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #3b82f6;
}
.stage-ABORTED .timeline-dot {
  background-color: #ef4444;
  box-shadow: 0 0 0 2rpx #ef4444;
}
.stage-REVIEWED .timeline-dot {
  background-color: #10b981;
  box-shadow: 0 0 0 2rpx #10b981;
}

.timeline-content {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.timeline-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.timeline-node-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}
.timeline-time {
  font-size: 20rpx;
  color: #94a3b8;
}
.timeline-operator {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}
.timeline-desc {
  font-size: 24rpx;
  color: #475569;
}

/* 底部操作条 */
.bottom-spacer {
  height: 140rpx;
}
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  padding: 18rpx 24rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-chat {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}
.btn-primary {
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}
.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}
.btn-review {
  background: #10b981;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}
.btn-feedback {
  background: #f59e0b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}
.btn-urge {
  background: #f97316;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}
.btn-abort {
  background: #fee2e2;
  color: #dc2626;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.modal-dialog {
  background: #ffffff;
  width: 600rpx;
  border-radius: 20rpx;
  padding: 36rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}
.modal-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 24rpx;
  line-height: 1.4;
}
.modal-input {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}
.modal-buttons {
  display: flex;
  gap: 16rpx;
}
.btn-cancel {
  flex: 1;
  background: #f1f5f9;
  color: #64748b;
  font-size: 26rpx;
  border: none;
  border-radius: 36rpx;
}
.btn-confirm-abort {
  flex: 1;
  background: #dc2626;
  color: #ffffff;
  font-size: 26rpx;
  border: none;
  border-radius: 36rpx;
}
