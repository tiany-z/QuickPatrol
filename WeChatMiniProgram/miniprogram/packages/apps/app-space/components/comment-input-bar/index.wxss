.input-bar-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
  z-index: 999;
}

.reply-target-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f1f3f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.target-text {
  font-size: 22rpx;
  color: #0078d7;
  font-weight: 500;
}

.cancel-reply-btn {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #dee2e6;
}

.cancel-icon {
  font-size: 20rpx;
  color: #495057;
}

.input-row {
  display: flex;
  align-items: center;
}

.avatar-trigger {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #e9ecef;
}

.guest-thumb {
  width: 100%;
  height: 100%;
}

.text-input {
  flex: 1;
  height: 68rpx;
  background: #f8f9fa;
  border-radius: 34rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #212529;
}

.send-btn {
  margin-left: 16rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: #0078d7;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 34rpx;
  padding: 0 28rpx;
  border: none;
}

.send-disabled {
  opacity: 0.5;
}

/* 授权弹窗 */
.auth-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.auth-modal-body {
  width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 24rpx;
}

.modal-avatar-btn {
  background: transparent;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: none;
  line-height: 1;
  margin-bottom: 24rpx;
}

.modal-avatar-btn::after {
  border: none;
}

.modal-avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e9ecef;
}

.modal-avatar-tip {
  font-size: 20rpx;
  color: #0078d7;
  margin-top: 8rpx;
}

.modal-nick-input {
  width: 100%;
  height: 72rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.modal-confirm-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  background: #0078d7;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 38rpx;
  border: none;
}
