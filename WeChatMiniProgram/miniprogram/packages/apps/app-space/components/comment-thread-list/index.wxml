<view class="thread-list-container">
  <block wx:for="{{threads}}" wx:key="rootComment.commentId">
    <view class="thread-node">
      <!-- 根评论区 -->
      <view class="root-comment-box">
        <image class="author-avatar" src="{{item.rootComment.authorAvatar}}" mode="aspectFill" />
        <view class="comment-main">
          <view class="author-header">
            <view class="name-badge-wrap">
              <text class="author-name">{{item.rootComment.authorName}}</text>
              <text wx:if="{{item.rootComment.isGuest}}" class="guest-tag">访客</text>
            </view>
            <text class="time-text">{{item.rootComment.createdAtText}}</text>
          </view>
          <text class="comment-text">{{item.rootComment.content}}</text>

          <!-- 根评论回复按钮 -->
          <view class="action-bar">
            <view
              class="reply-trigger"
              data-comment-id="{{item.rootComment.commentId}}"
              data-author-name="{{item.rootComment.authorName}}"
              bindtap="onTapReply"
            >
              <text class="reply-icon">💬</text>
              <text class="reply-label">回复</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 二级收敛楼中楼回复区 -->
      <view wx:if="{{item.subReplies && item.subReplies.length > 0}}" class="sub-replies-nest">
        <block wx:for="{{item.subReplies}}" wx:for-item="sub" wx:key="commentId">
          <view class="sub-item">
            <view class="sub-line">
              <text class="sub-author">{{sub.authorName}}</text>
              <text wx:if="{{sub.replyToNick}}" class="reply-arrow"> 回复 </text>
              <text wx:if="{{sub.replyToNick}}" class="reply-target">@{{sub.replyToNick}}</text>
              <text class="colon">: </text>
              <text class="sub-content">{{sub.content}}</text>
            </view>
            <view class="sub-meta">
              <text class="sub-time">{{sub.createdAtText}}</text>
              <text
                class="sub-reply-btn"
                data-comment-id="{{sub.commentId}}"
                data-author-name="{{sub.authorName}}"
                bindtap="onTapReply"
              >
                回复
              </text>
            </view>
          </view>
        </block>

        <!-- 查看更多二级回复展开按钮 -->
        <view
          wx:if="{{item.totalSubCount > item.subReplies.length}}"
          class="expand-more-btn"
          data-root-id="{{item.rootComment.commentId}}"
          bindtap="onExpandMoreSubReplies"
        >
          <text class="expand-text">展开更多 {{item.totalSubCount - item.subReplies.length}} 条回复 ▼</text>
        </view>
      </view>
    </view>
  </block>
</view>
