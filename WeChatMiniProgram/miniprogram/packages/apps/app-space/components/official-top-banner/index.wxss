.official-banner-container {
  width: 100%;
  margin: 16rpx 0 24rpx;
  box-sizing: border-box;
  position: relative;
}

.banner-swiper {
  height: 220rpx;
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-card {
  height: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 紧急检修红头样式 */
.banner-critical {
  background: linear-gradient(135deg, #FF2D55 0%, #BA0C2F 100%);
  color: #FFFFFF;
}

/* 重大白皮书橙红样式 */
.banner-urgent {
  background: linear-gradient(135deg, #FF6B00 0%, #D9381E 100%);
  color: #FFFFFF;
}

/* 日常官方权威通告样式 */
.banner-normal {
  background: linear-gradient(135deg, #0A84FF 0%, #1D4ED8 100%);
  color: #FFFFFF;
}

.banner-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(8px);
}

.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 0 8rpx #FFFFFF;
  animation: pulseGlow 1.8s infinite ease-in-out;
}

@keyframes pulseGlow {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 14rpx #FFFFFF; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

.tag-text {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.dept-text {
  font-size: 20rpx;
  opacity: 0.88;
  font-weight: 400;
}

.banner-body {
  margin: 6rpx 0;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.banner-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  opacity: 0.9;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 4rpx;
}

.banner-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  padding-top: 10rpx;
}

.expire-tip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  opacity: 0.85;
}

.expire-icon {
  font-size: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  transition: background 0.2s ease;
}

.arrow {
  font-size: 26rpx;
  line-height: 22rpx;
}

/* 轮播圆点指示条 */
.indicator-bar {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.indicator-dot {
  width: 10rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(0, 0, 0, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.indicator-dot.active {
  width: 28rpx;
  background: #FF3B30;
}
