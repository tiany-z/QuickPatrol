.stream-container {
  min-height: 100vh;
  background: #f4f6f9;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* 顶部形象 Banner */
.hero-banner {
  background: linear-gradient(135deg, #0078d7 0%, #004578 100%);
  padding: 48rpx 32rpx 36rpx 32rpx;
  color: #ffffff;
}

.banner-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-dot {
  color: #28a745;
  font-size: 16rpx;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.banner-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.banner-slogan {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
  line-height: 1.4;
}

/* 轨道与排序切换栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 99;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.track-tabs {
  display: flex;
  gap: 12rpx;
}

.tab-item {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #f1f3f5;
  font-size: 24rpx;
  color: #495057;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-active {
  background: #0078d7;
  color: #ffffff;
  font-weight: bold;
}

.sort-toggle {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  background: #fff8e6;
  border: 1rpx solid #ffe8b3;
  border-radius: 30rpx;
}

.sort-text {
  font-size: 22rpx;
  color: #b7791f;
  font-weight: 600;
}

/* 双列瀑布流容器 */
.masonry-wrap {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}

.masonry-col {
  width: 48.5%;
  display: flex;
  flex-direction: column;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #495057;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #868e96;
  text-align: center;
  line-height: 1.5;
}

/* 底部加载 */
.footer-loader {
  padding: 36rpx 0;
  text-align: center;
}

.loader-text {
  font-size: 22rpx;
  color: #888888;
}

.end-text {
  font-size: 20rpx;
  color: #adb5bd;
}
