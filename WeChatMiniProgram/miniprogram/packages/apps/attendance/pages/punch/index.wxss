/* packages/apps/attendance/pages/punch/index.wxss */
.punch-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: radial-gradient(circle at 50% 20%, #1E293B 0%, #0F172A 100%);
  padding: 30rpx 32rpx;
  box-sizing: border-box;
  color: #FFFFFF;
}

.time-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-text {
  font-size: 26rpx;
  color: #94A3B8;
  margin-bottom: 6rpx;
}

.clock-text {
  font-size: 64rpx;
  font-weight: 800;
  color: #F8FAFC;
  letter-spacing: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.geo-status-tag {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(30, 41, 59, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.geo-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #07C160;
  box-shadow: 0 0 10rpx #07C160;
}

.geo-status-tag.out-fence .geo-dot {
  background: #EF4444;
  box-shadow: 0 0 10rpx #EF4444;
}

.geo-text {
  font-size: 22rpx;
  color: #CBD5E1;
}

.shift-summary-bar {
  display: flex;
  align-items: center;
  background: rgba(59, 130, 246, 0.15);
  border: 1rpx solid rgba(59, 130, 246, 0.3);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin-bottom: 24rpx;
}

.shift-icon {
  margin-right: 10rpx;
  font-size: 26rpx;
}

.shift-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #93C5FD;
}

.shift-time {
  font-size: 22rpx;
  color: #BFDBFE;
  margin-left: 8rpx;
}

/* 相机圆形取景器 */
.camera-wrapper {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5), 0 0 30rpx rgba(59, 130, 246, 0.3);
  border: 6rpx solid #38BDF8;
  margin-bottom: 24rpx;
}

.face-camera {
  width: 100%;
  height: 100%;
}

.face-guideline-circle {
  width: 100%;
  height: 100%;
  border: 4rpx dashed rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scanning-ripple.animating {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 6rpx solid #38BDF8;
  animation: pulse-ring 1.4s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

@keyframes pulse-ring {
  0% { transform: scale(0.85); opacity: 0.9; }
  100% { transform: scale(1.15); opacity: 0; }
}

/* 活体提示 */
.hint-card {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx;
  background: rgba(30, 41, 59, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #E2E8F0;
  font-weight: 500;
}

/* 已打卡小药丸 */
.records-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.record-pill {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(148, 163, 184, 0.2);
  font-size: 22rpx;
}

.record-pill.done {
  border-color: rgba(7, 193, 96, 0.4);
  background: rgba(7, 193, 96, 0.1);
}

.pill-label {
  color: #94A3B8;
  margin-right: 8rpx;
}

.pill-val {
  color: #F1F5F9;
  font-weight: 500;
}

.record-pill.done .pill-val {
  color: #4ADE80;
}

/* 核心打卡圆盘 */
.action-area {
  margin-bottom: 28rpx;
}

.punch-circle-btn {
  width: 240rpx !important;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0284C7 0%, #0369A1 50%, #075985 100%);
  box-shadow: 0 16rpx 36rpx rgba(2, 132, 199, 0.45), 0 0 20rpx rgba(56, 189, 248, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.2s ease;
}

.punch-circle-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 20rpx rgba(2, 132, 199, 0.3);
}

.punch-circle-btn.disabled {
  background: #475569;
  box-shadow: none;
  opacity: 0.6;
}

.btn-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-time {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* 底部操作与二维码降级 */
.fallback-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: auto;
  margin-bottom: 20rpx;
}

.switch-type-link {
  font-size: 24rpx;
  color: #38BDF8;
  text-decoration: underline;
  cursor: pointer;
}

.qr-fallback-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: rgba(30, 41, 59, 0.6);
  border: 1rpx dashed rgba(148, 163, 184, 0.3);
  border-radius: 20rpx;
}

.qr-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.qr-text {
  font-size: 22rpx;
  color: #94A3B8;
}
