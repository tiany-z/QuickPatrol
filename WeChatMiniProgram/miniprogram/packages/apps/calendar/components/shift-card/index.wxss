/* 高校后勤巡查e速办 v4.0 - M51 值班师傅名牌微组件样式 */

.shift-card-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 22rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border: 1rpx solid rgba(59, 130, 246, 0.25);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.06);
}

.staff-info-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.staff-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.15);
}

.staff-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.staff-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.dept-badge {
  font-size: 18rpx;
  background: #2563EB;
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.shift-time {
  font-size: 22rpx;
  color: #3B82F6;
  font-weight: 500;
}

.location-text {
  font-size: 20rpx;
  color: #64748B;
}

.btn-call {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
  line-height: 1.4;
  margin: 0;
}

.btn-call-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

.call-icon {
  font-size: 24rpx;
}
