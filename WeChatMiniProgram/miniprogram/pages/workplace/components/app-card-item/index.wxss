/* 高校后勤巡查e速办 v4.0 - M50 飞书工作台微应用卡片样式 */

.app-card-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx 16rpx 10rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.app-card-hover {
  transform: scale(0.96);
  background: #F8FAFC;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.06);
}

.app-card-wrapper.is-pinned {
  border-color: rgba(59, 130, 246, 0.3);
  background: linear-gradient(180deg, #F0FDF4 0%, #FFFFFF 100%);
}

/* 置顶角标 */
.pinned-indicator {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  font-size: 20rpx;
  opacity: 0.85;
}

.pin-badge-btn {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E2E8F0;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 10;
  transition: all 0.15s ease;
}

.pin-badge-btn.active {
  background: #3B82F6;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.4);
}

/* 图标容器 */
.app-icon-box {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(255, 255, 255, 0.8);
  transition: transform 0.2s ease;
}

.app-icon-text {
  font-size: 52rpx;
  line-height: 1;
}

/* 四象限渐变背景 */
.category-emergency {
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
  border: 1rpx solid rgba(239, 68, 68, 0.15);
}

.category-service {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.15);
}

.category-daily {
  background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
  border: 1rpx solid rgba(14, 165, 233, 0.15);
}

.category-management {
  background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%);
  border: 1rpx solid rgba(139, 92, 246, 0.15);
}

/* 徽标 */
.app-badge-pill {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
  border: 2rpx solid #FFFFFF;
  z-index: 5;
}

/* 毛玻璃门禁蒙层 */
.gate-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 4;
}

.frosted-gate {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border: 1rpx dashed #94A3B8;
}

.restricted-gate {
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.gate-symbol {
  font-size: 32rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

/* 标题 */
.app-title-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 4rpx;
}

.app-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #1E293B;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  line-height: 1.3;
}

.app-title.dimmed {
  color: #64748B;
}

/* 门禁标签提示 */
.lock-tag {
  margin-top: 4rpx;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: #F1F5F9;
  color: #64748B;
  font-weight: 500;
  line-height: 1.2;
}

.lock-tag.restricted {
  background: #FEE2E2;
  color: #DC2626;
}

/* 状态修饰 */
.status-restricted {
  opacity: 0.75;
}

.status-frosted_lock {
  border-style: dashed;
}
